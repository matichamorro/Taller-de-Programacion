  area6: AreaP (6,51,6,60)
  area7: AreaP (2,1,2,1)
  
robots
  robot robot1
  variables
    total:numero
  comenzar
    recorrerEsquinas(total)
    EnviarMensaje(total, R_amon)
  fin
  
