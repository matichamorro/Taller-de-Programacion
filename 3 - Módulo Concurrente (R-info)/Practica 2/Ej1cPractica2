programa ejemplo
procesos
  proceso juntarFlores(ES numFlores: numero)
  comenzar
    numFlores:= 0
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      numFlores:= numFlores + 1
  fin
  proceso recorrerEsquinas(ES totalFlores: numero)
  variables
    aux:numero
  comenzar
    totalFlores:= 0
    repetir 9
      juntarFlores(aux)
      totalFlores:= totalFlores + aux
      mover
    juntarFlores(aux)
    totalFlores:= totalFlores + aux
  fin
  proceso Maximo(ES max:numero; E aux:numero)
  comenzar
    si (aux > max)
      max:= aux
  fin
