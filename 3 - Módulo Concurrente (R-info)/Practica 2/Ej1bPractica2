programa ejemplo
procesos
  proceso juntarFlores(ES numFlores: numero)
  comenzar
    numFlores:= 0
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      numFlores:= numFlores + 1
  fin
  proceso recorrerEsquinas(ES totalFlores: numero)
  variables
    aux:numero
  comenzar
    totalFlores:= 0
    repetir 9
      juntarFlores(aux)
      totalFlores:= totalFlores + aux
      mover
    juntarFlores(aux)
    totalFlores:= totalFlores + aux
  fin
areas
  area1: AreaP (1,1,1,10)
  area2: AreaP (2,11,2,20)
  area3: AreaP (2,1,2,1)
robots
  robot robot1
  variables
    total:numero
  comenzar
    recorrerEsquinas(total)
    EnviarMensaje(total, R_amon)
  fin
  
  robot fiscalizador
  variables
    total:numero
    totalOtro:numero
  comenzar
    RecibirMensaje(total, R_oberto)
    RecibirMensaje(totalOtro, R_ocio)
    si (total > totalOtro)
      Informar(total-totalOtro)
    sino
      Informar(totalOtro-total)
  fin
variables
  R_amon: fiscalizador
  R_ocio: robot1
  R_oberto: robot1
comenzar
  AsignarArea(R_oberto, area1)
  AsignarArea(R_ocio, area2)
  AsignarArea(R_amon, area3)
  Iniciar(R_amon, 2,1)
  Iniciar(R_ocio, 2,11)
  Iniciar(R_oberto, 1,1)
fin