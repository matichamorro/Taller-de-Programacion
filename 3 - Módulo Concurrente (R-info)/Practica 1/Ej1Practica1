programa ejemplo
procesos
  proceso juntarFlores(ES totalFlores: numero)
  variables
    num: numero
  comenzar
    num:= 0
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      num:= num + 1
    totalFlores:= totalFlores + num
  fin  
  proceso depositarFlores(E totalFlores: numero)
  comenzar
    repetir totalFlores
      depositarFlor
  fin
  proceso recorrerAvenida(E numAv: numero; ES totalFlores: numero; ES esquinasVacias: numero )
  comenzar
    totalFlores := 0
    esquinasVacias := 0
    Pos(numAv, 1)
    repetir 99
      mover
      si (HayFlorEnLaEsquina)
        juntarFlores(totalFlores)
      sino
        esquinasVacias := esquinasVacias + 1
    depositarFlores(totalFlores)
  fin
