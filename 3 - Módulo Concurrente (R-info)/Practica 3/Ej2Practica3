programa ejercicioDos
procesos
  proceso izquierda
  comenzar
    repetir 3
      derecha
  fin
  proceso escalonFlor(E num: numero; ES flores:numero)
  comenzar
    repetir num
      mover
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
    derecha
    repetir num
      mover
    izquierda
  fin
  proceso escalonPapel(E num: numero; ES papeles:numero)
  comenzar
    repetir num
      mover
    mientras (HayPapelEnLaEsquina)
      tomarPapel
      papeles:=papeles+1
    izquierda
    repetir num
      mover
    derecha
  fin
areas
  areaF1: AreaP (1,2,15,31)
  areaF2: AreaP (1,1,14,2)
  areaP: AreaP (17,1,31,31)
  esquinaCentral: AreaPC (16,16,16,16)
  inicioJefe: AreaP (15,1,15,1)

robots
  robot robot1
  variables
    i, flores:numero
  comenzar
    flores:=0
    i:=5
    repetir 4
      escalonFlor(i,flores)
      i:=i-1
    BloquearEsquina(16,16)
    escalonFlor(i,flores)
    mientras (HayFlorEnLaEsquina)
      tomarFlor
      flores:=flores+1
    EnviarMensaje(1,R_amon) 
    izquierda
    mover
    LiberarEsquina(16,16)
    i:=2
    repetir 4
      escalonFlor(i,flores)
      i:=i+ 1
    Informar("las flores juntadas son ",flores)
    EnviarMensaje(V,R_amon)
  fin
  robot robot2 
  variables 
    i, papeles:numero 
  comenzar
    papeles:=0
    i:=5
    repetir 4
      escalonPapel(i,papeles)
      i:=i-1
    BloquearEsquina(16,16)
    escalonPapel(i,papeles)
    mientras (HayPapelEnLaEsquina)
      tomarPapel
      papeles:=papeles+1
    EnviarMensaje(2,R_amon)
    derecha
    mover
    LiberarEsquina(16,16)
    i:=2
    repetir 4
      escalonPapel(i,papeles)
      i:=i+ 1
    Informar("los papeles juntados son ",papeles)
    EnviarMensaje(V,R_amon)
  fin
  robot jefe
  variables
    ganador:numero
    segundo:numero
    aux: boolean
  comenzar
    RecibirMensaje(ganador,*)
    RecibirMensaje(segundo,*)
    RecibirMensaje(aux,*)
    RecibirMensaje(aux,*)
    Informar("El ganador fue el ",ganador)
  fin
variables
  R_uno: robot1
  R_dos: robot2
  R_amon: jefe
comenzar
  AsignarArea(R_uno, areaF1)
  AsignarArea(R_uno, areaF2)
  AsignarArea(R_dos, areaP)
  AsignarArea(R_uno, esquinaCentral)
  AsignarArea(R_dos, esquinaCentral)
  AsignarArea(R_amon, inicioJefe)
  Iniciar(R_uno, 1,1)
  Iniciar(R_dos, 31,1)
  Iniciar(R_amon, 15,1)
fin